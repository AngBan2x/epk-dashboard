# Turso Database (F4)
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# YouTube Data API v3
YOUTUBE_API_KEY=your-youtube-api-key

# Last.fm API — OPCIONAL. Sin esta clave la app funciona igual: `lib/lastfm.ts`
# devuelve `no_key` y la cadena de métricas cae a la siguiente fuente
# (tracks.metrics curados -> YouTube -> "— sin dato"). Se usa para los scrobbles
# por pista, la última fuente de `lib/metrics-source.ts`.
LASTFM_API_KEY=your-lastfm-api-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firma HMAC para webhooks entrantes (POST /api/webhooks/metrics, /api/tracks/:id/streams)
WEBHOOK_SECRET=genera-una-cadena-larga-y-aleatoria

# Firma de las cookies de sesion (HMAC-SHA256). OBLIGATORIA en produccion:
# lib/auth.ts lanza si no existe. Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ─── Credenciales de test (SOLO tests y scripts de QA, nunca la app) ──────────
# Las usan `scripts/lib/credentials.ts` (fuente unica de verdad), los specs de
# Playwright via `tests/e2e/credentials.ts`, y los scripts de `scripts/`.
# Playwright NO hereda la carga de `.env.local` de Next: por eso
# `playwright.config.ts` la carga explicitamente con dotenv.
#
# Local: ponlas aqui (copia a `.env.local`, que esta en .gitignore).
# CI: deben venir del secret store del proveedor. NO las subas al repositorio.
#
# El helper NO tiene contrasena por defecto: si faltan, el script falla con un
# mensaje que nombra la variable, en vez de autenticarse con algo del repo.
# El email del admin si tiene default (`admin@epk.local`), porque no es un
# secreto.
TEST_ARTIST_EMAIL=
TEST_ARTIST_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_SUBSCRIBER_EMAIL=
TEST_SUBSCRIBER_PASSWORD=

# ─── Humo de correo (P3) — Opcional, y fuera del camino de la app ─────────────
# Corresponde a `scripts/verify-resend-smoke.ts`. NO es un test: es un script,
# a proposito, porque enviar de verdad gasta la cuota de Resend (100 correos/mes
# en el plan gratis) y depende de la red. La capa que corre en cada push es
# `tests/unit/email.test.ts`, con transporte falso y sin red.
#
# RESEND_SMOKE tiene que valer EXACTAMENTE "1" para que se envie algo. Cualquier
# otro valor ("0", "true", "", sin definir) deja el envio real desactivado, y el
# script sale 0 sin enviar. Esa es la puerta: sin ella, correr la suite podria
# vaciar la cuota del mes sin que nadie lo hubiera pedido.
#
# RESEND_SMOKE_TO es el correo del TITULAR de la cuenta de Resend, y solo se
# necesita mientras no haya dominio verificado: `onboarding@resend.dev` entrega
# unicamente a esa direccion y a ninguna otra (a las demas, Resend responde 403).
# En cuanto verifiques un dominio y pongas FROM_EMAIL, esto deja de hacer falta.
#
# DEJALA VACIA a proposito. No pongas un ejemplo tipo `tucorreo@example.com`:
# Resend rechaza los dominios de ejemplo con 422 ("Please use our testing email
# address instead of domains like example.com"), asi que un placeholder
# copiado tal cual daria un fallo de Envio que parece de codigo y no lo es.
# Un valor vacio hace que el script pare antes de llamar y lo diga claro.
RESEND_SMOKE=
RESEND_SMOKE_TO=

# Vercel Blob (subidas de imagenes: perfil, banner, galeria)
# El store esta conectado al proyecto, asi que en produccion la plataforma
# inyecta un token OIDC de vida corta por request y no hace falta ningun
# secreto. NO definas BLOB_READ_WRITE_TOKEN: pasar un token explicito tiene
# prioridad sobre OIDC en el SDK y volveria a activar la credencial estatica.
# Para desarrollo local: `vercel env pull .env.local` (trae BLOB_STORE_ID).
BLOB_STORE_ID=
